[Unit]
Description=Nexus Node personal assistant (web hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/nexus-node
EnvironmentFile=-%h/nexus-node/.env
ExecStart=%h/nexus-node/.venv/bin/python %h/nexus-node/main.py --mode web --host 0.0.0.0 --port 8743
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
