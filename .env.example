# Nexus Node — copy to `.env`

# Default host AI key (optional if each Telegram user sets /apikey)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OpenAI-compatible providers (Groq, LM Studio, Together, …)
# OPENAI_BASE_URL=https://api.openai.com/v1

# This machine
DEVICE_ID=home-pc
DEVICE_NAME=Home PC

# Telegram hub
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_CHAT_ID=
# TELEGRAM_PAIR_CODE=
# TELEGRAM_PAIRING_OPEN=false
TELEGRAM_PAIR_MAX_ATTEMPTS=5
TELEGRAM_PAIR_LOCKOUT_SECONDS=900
TELEGRAM_MAX_FRIENDS=5

# Worker mode (other devices): same token must be registered on the hub via /device_add
WORKER_TOKEN=
WORKER_HOST=127.0.0.1
WORKER_PORT=8765

# Safety
SHELL_ENABLED=true
# SHELL_ALLOW_PREFIXES=
INBOUND_MAX_BYTES=26214400
FRIEND_CAN_KILL_PROCESS=false
NOTIFY_OWNER_ON_FRIEND_COMMAND=true
CONFIRMATION_TIMEOUT_SECONDS=120

# Paths / binaries
# NEXUS_DATA_DIR=
# ADB_PATH=adb
# CURSOR_CLI_PATH=cursor
# STEAMCMD_PATH=steamcmd
