# Nexus Node — copy to `.env`

# Optional host-wide AI key (users can also set their own in the web app)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# This machine (hub or worker)
DEVICE_ID=home-pc
DEVICE_NAME=Home PC

# Web hub
NEXUS_WEB_HOST=0.0.0.0
NEXUS_WEB_PORT=8743
# NEXUS_JWT_SECRET=   # auto-generated in data/jwt_secret.txt if unset
# NEXUS_SECRETS_KEY=  # Fernet key; auto-generated in data/secrets.key
NEXUS_OPEN_SIGNUP=false
NEXUS_MAX_MEMBERS=50
# NEXUS_WEB_TLS=true   # self-signed HTTPS (python main.py --tls) for Web Push

# Worker mode (other devices)
WORKER_TOKEN=
WORKER_HOST=127.0.0.1
WORKER_PORT=8765

# Safety
SHELL_ENABLED=true
INBOUND_MAX_BYTES=26214400
FRIEND_CAN_KILL_PROCESS=false
CONFIRMATION_TIMEOUT_SECONDS=120

# Legacy Telegram (optional) — also used for send_telegram_message to contacts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_CHAT_ID=
# TELEGRAM_CHAT_ID=

# Public URL of this hub (used for Google OAuth redirect if GOOGLE_REDIRECT_URI unset)
# NEXUS_PUBLIC_URL=http://127.0.0.1:8743

# Google OAuth (Gmail + Calendar) — create OAuth client in Google Cloud Console
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8743/api/google/callback

# Web search (optional — DuckDuckGo HTML fallback works without a key)
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Outbound email (send_email tool — always asks for confirmation)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=you@example.com
# SMTP_STARTTLS=true
# SMTP_TLS=false   # use SMTP_SSL instead of STARTTLS (e.g. port 465)

# WhatsApp Cloud API (send_whatsapp_message — always asks for confirmation)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Weather for daily briefing uses Open-Meteo (no key).
# Default city/timezone: Tel Aviv / Asia/Jerusalem (change in Settings → Morning briefing).

# Paths
# NEXUS_DATA_DIR=
# ADB_PATH=adb
# CURSOR_CLI_PATH=cursor
# STEAMCMD_PATH=steamcmd
