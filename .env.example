# Nexus Node — local environment example
# Copy to `.env` and fill in values you need.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Phone access + file backup (Telegram)
TELEGRAM_BOT_TOKEN=
# Optional: pre-seed allowlist (still can /pair)
TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=123456789,-100987654321
# Optional fixed pair code (otherwise auto-generated into data/pair_code.txt)
# TELEGRAM_PAIR_CODE=AB12CD
CONFIRMATION_TIMEOUT_SECONDS=120

# Local data paths (defaults: ./data and ./data/inbox)
# NEXUS_DATA_DIR=
# NEXUS_INBOX_DIR=
# NEXUS_AUDIT_LOG=

# Safety
SHELL_ENABLED=true
# Optional: only allow commands that start with these prefixes (comma-separated)
# SHELL_ALLOW_PREFIXES=ls ,df ,uptime,cat 
# Optional: override default deny regexes (comma/newline-separated)
# SHELL_DENY_PATTERNS=
# Max inbound Telegram file size in bytes (default 25 MiB)
INBOUND_MAX_BYTES=26214400

# Optional binary overrides
ADB_PATH=adb
CURSOR_CLI_PATH=cursor
STEAMCMD_PATH=steamcmd

# Optional SteamCMD login (otherwise anonymous)
# STEAM_USERNAME=
# STEAM_PASSWORD=
