{
  "name": "Nexus Node",
  "short_name": "Nexus",
  "description": "Personal assistant for your devices",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b1f1c",
  "theme_color": "#0b1f1c",
  "lang": "en",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open chat",
      "short_name": "Chat",
      "description": "Jump into your last conversation",
      "url": "/?tab=chat",
      "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
    },
    {
      "name": "Voice",
      "short_name": "Voice",
      "description": "Start talking to Nexus",
      "url": "/?tab=chat&voice=1",
      "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
    },
    {
      "name": "Daily briefing",
      "short_name": "Briefing",
      "description": "Ask for today's briefing",
      "url": "/?tab=chat&briefing=1",
      "icons": [{ "src": "/favicon.svg", "sizes": "any" }]
    }
  ]
}
